#!/usr/bin/env ruby
# .gitattributes を作成し、改行コードをLFに統一する設定を書き込む
# 実行場所: リポジトリのルート(.gitと同じ階層)で実行してください

path = ".gitattributes"
content = "* text=auto eol=lf\n"

if File.exist?(path)
  puts "既に #{path} が存在します。上書きしますか? (y/N)"
  answer = $stdin.gets&.strip&.downcase
  unless answer == "y"
    puts "中止しました。"
    exit
  end
end

# バイナリ書き込みでLF固定(Windows上でRubyがCRLFに変換しないように)
File.binwrite(path, content)

puts "#{path} を作成しました:"
puts "----"
puts content
puts "----"

# .standard.yml に Layout/EndOfLine を無効化する設定を追記する
# (LFで統一する方針のため、CRLFを要求するこのcopは無効化する)
standard_yml = ".standard.yml"
if File.exist?(standard_yml)
  require "yaml"
  yaml = YAML.load_file(standard_yml) || {}
  yaml["ignore"] ||= []
 
  entry = yaml["ignore"].find { |e| e.is_a?(Hash) && e.key?("**/*") }
  if entry
    entry["**/*"] ||= []
    entry["**/*"] << "Layout/EndOfLine" unless entry["**/*"].include?("Layout/EndOfLine")
  else
    yaml["ignore"] << {"**/*" => ["Layout/EndOfLine"]}
  end
 
  File.binwrite(standard_yml, yaml.to_yaml)
  puts "#{standard_yml} に Layout/EndOfLine の無効化設定を追加しました。"
else
  puts "#{standard_yml} が見つからないため、この設定の追記はスキップしました。"
end

def run(cmd)
  puts "$ #{cmd}"
  system(cmd)
  puts
end

run("git add #{path}")

run("git config core.autocrlf false")

run("git add --renormalize .")
run("git status")

# ステージされた変更があるかどうかを確認してからcommitする
# (git diff --cached --quiet は差分なしの場合 exit code 0、差分ありなら1)
system("git diff --cached --quiet")
if $?.success?
  puts "変更がないため commit はスキップしました。"
else
  run('git commit -m "Normalize line endings to LF"')
end

run("git rm -r --cached .")
run("git checkout HEAD -- .")
