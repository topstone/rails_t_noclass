# frozen_string_literal: true

# 実行環境のロケール設定に関わらず、日本語などの非ASCII文字を含む
# 引数を正しく扱えるように、外部エンコーディングをUTF-8に固定する。
Encoding.default_external = Encoding::UTF_8

# comment_out_gemspec.rb
#
# カレントディレクトリの *.gemspec ファイルすべてに対し、以下の行を
# コメントアウトします。
#
#   * spec.description
#   * spec.homepage
#   * spec.license
#   * spec.metadata (すべて)
#
# さらに、コマンドライン引数を渡すと spec.summary の値をその文字列に
# 書き換えます。引数に空白を含めたい場合は引用符で囲んでください。
#
# 使い方:
#   ruby comment_out_gemspec.rb
#   ruby comment_out_gemspec.rb "あいうえお"
#   ruby comment_out_gemspec.rb "spaces are ok"
#
# 既にコメントアウトされている行はそのままにし、二重にコメントアウト
# しません。

TARGET_PATTERN  = /\Aspec\.(description|homepage|license|metadata)\b/
SUMMARY_PATTERN = /\Aspec\.summary\s*=/

def split_line(line)
  if line =~ /\A(\s*)(.*\S)?(\s*)\z/m
    indent = Regexp.last_match(1)
    body   = Regexp.last_match(2) || ""
    trail  = Regexp.last_match(3) || ""
  else
    indent = ""
    body   = line
    trail  = ""
  end
  [indent, body, trail]
end

def comment_out_line(line)
  indent, body, trail = split_line(line)

  return line if body.empty?
  return line if body.start_with?("#") # 既にコメントアウト済み
  return line unless body =~ TARGET_PATTERN

  "#{indent}# #{body}#{trail}"
end

def update_summary_line(line, new_summary)
  indent, body, trail = split_line(line)

  return line if body.empty?
  return line if body.start_with?("#") # コメントアウトされた行は対象外
  return line unless body =~ SUMMARY_PATTERN

  "#{indent}spec.summary = #{new_summary.inspect}#{trail}"
end

# コマンドライン引数の受け取り
# 例: ruby comment_out_gemspec.rb "あいうえお" のように引用符で囲めば、
#     空白を含む文字列も1つの引数として渡せる。
new_summary = ARGV.empty? ? nil : ARGV.join(" ").dup.force_encoding(Encoding::UTF_8)

gemspec_files = Dir.glob("*.gemspec")

if gemspec_files.empty?
  warn "カレントディレクトリに *.gemspec が見つかりませんでした。"
  exit 1
end

gemspec_files.each do |file|
  original_lines = File.readlines(file)

  new_lines = original_lines.map { |line| comment_out_line(line) }
  new_lines = new_lines.map { |line| update_summary_line(line, new_summary) } if new_summary

  if new_lines == original_lines
    puts "変更なし: #{file}"
  else
    File.write(file, new_lines.join)
    puts "更新しました: #{file}"
  end
end
