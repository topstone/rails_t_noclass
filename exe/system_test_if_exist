# update_ci.rb
file_path = '.github/workflows/ci.yml'

# ファイルを読み込む
content = File.read(file_path)

# 置換前のパターン
old_pattern = <<~PATTERN.chomp
run: bundle exec rails db:migrate && bundle exec rails test:system
PATTERN

# 置換後の内容
new_content = <<~SCRIPT.chomp
run: |
          bundle exec rails db:migrate
          if [ -d "test/system" ] && [ "$(ls -A test/system)" ]; then
            bundle exec rails test:system
          fi
SCRIPT

# 置換実行
if content.include?(old_pattern)
  content.gsub!(old_pattern, new_content)
  File.write(file_path, content)
  puts "✅ #{file_path} を更新しました"
  puts "条件付き実行に変更: test/system ディレクトリが存在し、空でない場合のみシステムテストを実行"
else
  puts "⚠️  対象のパターンが見つかりませんでした"
end