#!/usr/bin/env ruby
# frozen_string_literal: true

# .github/workflows/ci.yml を編集するスクリプト
# db:test:prepare を db:migrate に変更する
# bin/rails と bundle exec rails の両方に対応

ci_file_path = "./.github/workflows/ci.yml"

unless File.exist?(ci_file_path)
  puts "エラー: #{ci_file_path} が見つかりません"
  exit 1
end

# ファイルを読み込む
content = File.read(ci_file_path)
original_content = content.dup

# 置換を実行
# より具体的なパターンから先に処理する
# キャプチャグループを使って、元のコマンド形式を維持する

# 1. test:system の場合
# (bin/rails|bundle exec rails) をキャプチャして再利用
content.gsub!(%r{run:\s*((?:bin/rails|bundle\s+exec\s+rails))\s+db:test:prepare\s+test:system},
              'run: \1 db:migrate && \1 test:system')

# 2. 通常の test の場合
content.gsub!(%r{run:\s*((?:bin/rails|bundle\s+exec\s+rails))\s+db:test:prepare\s+test(?!:)},
              'run: \1 db:migrate && \1 test')

# 変更があったかチェック
if content == original_content
  puts "変更対象の行が見つかりませんでした"
else
  # ファイルに書き込む
  File.write(ci_file_path, content)
  puts "#{ci_file_path} を更新しました"
  puts ""
  puts "変更内容:"
  puts "  'db:test:prepare test:system' → 'db:migrate && [元のコマンド] test:system'"
  puts "  'db:test:prepare test' → 'db:migrate && [元のコマンド] test'"
end
